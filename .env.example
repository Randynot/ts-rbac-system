# Application Setup
APP_NAME=ts-rbac-system
NODE_ENV=development
PORT=3000

# Security & CORS Setup
# Comma-separated list of allowed origins (no trailing slashes)
CORS_ORIGINS=http://localhost:3000,http://localhost:3500

# Database Configuration (PostgreSQL / Neon Connection String)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT Configuration
# Generate secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_VERIFICATION_SECRET=your_jwt_verification_secret_here

# Token Expiry Settings
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=12
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_SECONDS=900

# Transactional Email Service (Resend / SMTP)
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USER=resend
EMAIL_PASS=your_email_password_or_provider_key
EMAIL_FROM_NAME="TS RBAC Engine"
EMAIL_FROM_ADDRESS="onboarding@resend.dev"
RESEND_API_KEY=your_resend_api_key
RESEND_WEBHOOK_SECRET=your_resend_webhook_secret

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=dbname
POSTGRES_PORT=5432


# Object Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Frontend Application Integration
FRONTEND_URL=http://localhost:3500

# Rate Limiting (Throttler)
# THROTTLE_TTL in seconds, THROTTLE_LIMIT max requests per window
THROTTLE_TTL=60
THROTTLE_LIMIT=10
